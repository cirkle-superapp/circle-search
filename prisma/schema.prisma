// Next-Generation Search Engine — Prisma schema
// Implements: crawl queue, document store, inverted index, links, entities,
// query/autocomplete logs, search history, sponsored ads (clearly separated
// from organic ranking).

generator client {
  provider        = "prisma-client-js"

}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CRAWLER / URL FRONTIER
// ---------------------------------------------------------------------------

/// A URL scheduled for (re)crawling. Implements the URL Frontier from §4.
model CrawlQueue {
  id            String   @id @default(cuid())
  url           String   @unique
  domain        String
  priority      Int      @default(0) // higher = crawled sooner
  discoverySrc  String   @default("seed") // seed | sitemap | extracted | suggestion
  status        String   @default("pending") // pending | fetching | done | error | skipped
  httpStatus    Int?
  robotsAllowed Boolean  @default(true)
  crawlDelayMs  Int      @default(1000)
  retryCount    Int      @default(0)
  lastCrawledAt DateTime?
  nextCrawlAt   DateTime?
  contentHash   String?
  addedAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextCrawlAt])
  @@index([domain])
}

// ---------------------------------------------------------------------------
// DOCUMENT STORE (parsed web pages)
// ---------------------------------------------------------------------------

/// A normalized, indexed web document. §5 document processing pipeline output.
model Document {
  id              String   @id @default(cuid())
  url             String   @unique
  canonicalUrl    String?
  domain          String
  title           String
  snippet         String // short extract shown in SERP
  contentText     String // full extracted body text
  headings        String  @default("[]") // JSON: [{level, text}]
  links           String  @default("[]") // JSON: [{url, anchor}]
  metaDescription String?
  metaKeywords    String?
  ogType          String?
  ogImage          String?

  sourceType      String   @default("WEB") // OFFICIAL|GOVERNMENT|ACADEMIC|NEWS|COMMUNITY|COMMERCIAL|PRIMARY|WEB
  language        String   @default("en")
  country         String?
  author          String?
  publisher       String?

  publishedAt     DateTime?
  updatedAt      DateTime?
  crawledAt      DateTime @default(now())

  contentHash     String?  // sha1 of normalized text — for exact dedup
  simhash        String?  // for near-duplicate detection
  clusterId      String?  // content/topic cluster key

  qualityScore    Float    @default(0.5) // 0..1 — info density, originality, etc.
  spamScore       Float    @default(0) // 0..1 — manipulative signals
  isOriginal     Boolean  @default(true)
  wordCount       Int      @default(0)

  indexTerms      String?  // JSON-encoded list of {t: term, f: freq, p: positions} (compact inverted postings for this doc)
  indexedTokenCount Int   @default(0) // P3-6: post-stopword-removal token count for accurate BM25 docLen
  embedding       Bytes?   // 384-dim MiniLM embedding (Float32Array buffer) for semantic search

  createdAt       DateTime @default(now())
  updatedAtDoc    DateTime @updatedAt
  deletedAt       DateTime?  // P2-7: soft-delete audit field

  @@index([domain])
  @@index([sourceType])
  @@index([clusterId])
  @@index([contentHash])
  @@index([crawledAt])
  @@index([publishedAt]) // P2-7: LATEST mode ORDER BY publishedAt DESC
  @@index([language])    // P2-7: filtered queries
  @@index([country])     // P2-7: filtered queries
  @@index([isOriginal]) // P2-7: dedup cluster filter
}

// ---------------------------------------------------------------------------
// LINK GRAPH (§7.4)
// ---------------------------------------------------------------------------

model Link {
  id             String   @id @default(cuid())
  sourceUrl      String
  targetUrl      String
  anchorText     String   @default("")
  relationship   String   @default("follow") // follow|nofollow|ugc|sponsor
  discoveredAt   DateTime @default(now())

  @@index([sourceUrl])
  @@index([targetUrl])
}

// ---------------------------------------------------------------------------
// ENTITY / KNOWLEDGE GRAPH (§7.3, §23)
// ---------------------------------------------------------------------------

model Entity {
  id           String   @id @default(cuid())
  name         String   @unique
  aliases      String   @default("[]") // JSON array
  type         String   // ORGANIZATION|PERSON|PLACE|PRODUCT|TECHNOLOGY|EVENT|PUBLICATION
  description   String?
  sourceRefs   String   @default("[]") // JSON: [{url, snippet}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// SEARCH HISTORY & QUERY LOGS (§37, §40)
// ---------------------------------------------------------------------------

/// A user's search session — only stored if personalization is enabled.
/// When private mode is on, nothing is persisted.
model SearchHistory {
  id           String   @id @default(cuid())
  query        String
  mode         String   @default("BALANCED")
  filters      String   @default("{}") // JSON of applied filters
  resultCount  Int      @default(0)
  searchedAt   DateTime @default(now())
  sessionId    String?  // anonymous session token; null in private mode

  @@index([sessionId])
  @@index([searchedAt])
}

/// Aggregated query statistics — used for autocomplete popularity. NOT tied
/// to any user identity (we only store a hash of the normalized query).
model QueryLog {
  id           String   @id @default(cuid())
  query        String   @unique
  normalized    String   @unique
  frequency    Int      @default(1)
  lastUsedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([normalized])
}

// ---------------------------------------------------------------------------
// ADVERTISING (§33) — strictly isolated from organic ranking
// ---------------------------------------------------------------------------

/// Sponsored results. Never mixed with organic. Each ad carries a
/// "Why this ad?" explanation. Advertiser cannot buy organic ranking.
model SponsoredAd {
  id           String   @id @default(cuid())
  advertiser    String
  headline     String
  displayUrl    String
  targetUrl    String
  snippet      String
  keywords     String   @default("[]") // JSON: matched keywords
  whyAdReason  String   // human-readable explanation
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// ---------------------------------------------------------------------------
// SAVED SEARCHES (§38) — opt-in
// ---------------------------------------------------------------------------

model SavedSearch {
  id           String   @id @default(cuid())
  query        String
  mode         String   @default("BALANCED")
  filters      String   @default("{}")
  frequency    String   @default("weekly") // immediate|daily|weekly
  createdAt    DateTime @default(now())
  sessionId    String?

  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// KEY-VALUE STORE — for durable metrics, budget counters, feature flags
// (P0-2: durable metrics, P2-6: durable BrightData budget counter)
// ---------------------------------------------------------------------------

model KeyValue {
  key         String   @id // caller-supplied stable key (e.g. "metrics:state")
  value       String   // JSON-encoded value
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// SEARCH FEEDBACK — collect 👍/👎 on individual results for ranking retraining
// ---------------------------------------------------------------------------

/// A user's vote on a search result. Used to:
///   - Identify the "right" result for a query (relevance tuning)
///   - Detect spam/low-quality results that slipped past the spam engine
///   - Train a future Learning-to-Rank model
model SearchFeedback {
  id           String   @id @default(cuid())
  query        String   // the original query
  docId        String   // the document the user voted on
  docUrl       String   // denormalized for analytics (survives doc deletion)
  vote         String   // 'up' | 'down' | 'spam' | 'irrelevant'
  reason       String?  // optional free-text feedback
  sessionId    String?  // anonymous session
  createdAt    DateTime @default(now())

  @@index([query])
  @@index([docId])
  @@index([createdAt])
  @@index([vote])
}
